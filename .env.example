NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Em produção, valide este arquivo preenchido com:
#   node scripts/check-production-env.js
# O comando não exibe os valores das variáveis.

# Proteção HTTP. RATE_LIMIT_MAX vale por IP em uma janela de 15 minutos.
RATE_LIMIT_MAX=600
# Orçamento global de falhas de reautenticação por usuário/IP. Todas as ações
# assinadas compartilham o mesmo contador, inclusive entre instâncias da API.
SIGNATURE_RATE_LIMIT_MAX=5
SIGNATURE_RATE_LIMIT_WINDOW_MS=600000
# Timeout da confirmação de senha no Supabase; aceito entre 1000 e 15000 ms.
SIGNATURE_TIMEOUT_MS=7000

# URL pública do frontend usada no QR/link de verificação dos laudos.
PUBLIC_APP_URL=http://localhost:4200
# Origens separadas por vírgula, sem barra final.
CORS_ORIGINS=http://localhost:4200,https://seu-frontend.vercel.app

# Banco de dados. Prefira DATABASE_URL; as variáveis DB_* são fallback.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Para validação TLS completa, informe a cadeia PEM (quebras de linha podem ser \n).
DATABASE_SSL_CA=
# Como alternativa, informe o caminho de um certificado CA público versionado.
DATABASE_SSL_CA_PATH=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

# Supabase (nunca versionar valores reais). A referência do projeto deve ser a
# mesma em SUPABASE_URL e no host/usuário da conexão PostgreSQL.
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave administrativa somente no backend. Configure Secret ou Service Role,
# nunca copie nenhuma delas para o frontend. Service Role é fallback legado.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Chave pública usada pelo backend exclusivamente na reautenticação por senha.
# Use Publishable em projetos modernos ou Anon + JWT Secret em projeto legado.
SUPABASE_PUBLISHABLE_KEY=
# Fallback somente para projeto legado que ainda usa a antiga chave anon.
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=https://seu-projeto.supabase.co/auth/v1/.well-known/jwks.json
# Necessário apenas em projeto legado com token HS256.
# Não configure este fallback em projetos modernos que possuem JWKS.
SUPABASE_JWT_SECRET=

# Identidade oficial congelada em cada laudo. Não é aceita pelo payload do cliente.
LAB_NOME=Laboratório emissor
LAB_DOCUMENTO=
LAB_ENDERECO=
LAB_CONTATO=

# Máximo de retroatividade aceito para evento de custódia (0 a 168 horas).
CUSTODY_MAX_BACKDATE_HOURS=24
