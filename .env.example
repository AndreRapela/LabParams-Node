NODE_ENV=development
PORT=3000

# Origens separadas por vírgula, sem barra final.
CORS_ORIGINS=http://localhost:4200,https://seu-frontend.vercel.app

# Banco de dados. Prefira DATABASE_URL; as variáveis DB_* são fallback.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DATABASE_SSL=true
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

# Supabase (nunca versionar valores reais).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
