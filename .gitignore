# ====================================
# DEPENDÊNCIAS
# ====================================
node_modules/
yarn.lock
pnpm-lock.yaml

# ====================================
# VARIÁVEIS DE AMBIENTE E SEGREDOS (CRÍTICO)
# ====================================
.env
.env.*
!.env.example
.env.local
.env.development
.env.test
.env.production

# Sobrescritas locais de configuração; os módulos que leem env são versionados.
config/*.local.js

# ====================================
# LOGS E DEBUG
# ====================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ====================================
# BUILD, DISTRIBUIÇÃO E CACHE
# ====================================
dist/
build/
coverage/
.nyc_output/
*.lcov
.cache/
.parcel-cache/

# ====================================
# TESTES
# ====================================
# Mantém arquivos de teste, mas ignora resultados
junit.xml
test-results/
*.test.js.snap

# ====================================
# UPLOADS E ARQUIVOS TEMPORÁRIOS
# ====================================
uploads/
temp/
tmp/
*.tmp
*.temp

# ====================================
# ARQUIVOS DE SISTEMA OPERACIONAL
# ====================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~

# ====================================
# IDEs E EDITORES
# ====================================
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
.history/

# ====================================
# VERCEL E DEPLOY
# ====================================
.vercel
.now

# ====================================
# CERTIFICADOS E CHAVES
# ====================================
*.pem
*.key
*.cert
*.crt

# CA pública oficial necessária para validar o TLS do Supabase no deploy.
!config/certs/
!config/certs/supabase-prod-ca-2021.crt

# ====================================
# BACKUP E DADOS SENSÍVEIS
# ====================================
*.backup
*.bak
*.sql
*.dump

# O esquema e o catálogo do Supabase fazem parte do código-fonte.
!supabase/migrations/
!supabase/migrations/*.sql
!supabase/seed.sql
